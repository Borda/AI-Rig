# Agent handover artifacts (ephemeral patch files)
.codex/handover/

# Codex CI harness artifacts generated during local and CI runs
.github/codex-harness-results/

# Delegation log (local runtime data, not source)
.codex/logs/
.codex/reports/

# Hook runtime state and invocation logs
.claude/state/
.claude/logs/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Per-machine permission overrides (auto-appended by "always allow" clicks,
# contains installer's own absolute home paths — never portable, never shared)
.claude/settings.local.json

# Skill run artifacts and temp outputs (ephemeral, TTL-managed)
.cache/
.notes/
.plans/
.developments/
.experiments/
.investigate/
.reports/
.temp/
.outputs/
docs/specs/
.codemapignore

# Agent auto-memory (machine-local, not source)
.codex/caveman-compress/
.claude/agent-memory/
benchmarks/.claude/
plugins/*/.claude/

# Local Claude overrides (not synced to ~/.claude/)
*.local.md

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Benchmarks and logs
benchmarks/results/

# Deterministic benchmark manifests are regenerated by benchmarks/run-all.sh.
benchmarks/manifests/

# Sandbox: external repos cloned for codemap debugging (never committed)
.sandbox/

# Documentation build artifacts
site/

#__pycache__
__pycache__/
*.py[cod]
*$py.class

.coverage*
uv.lock

.DS_Store
