#!/bin/sh
# Purpose: bootstrap the unchanged python command when only python3 is installed.
# Scope: standalone POSIX launch boundary; no Python is needed to start it.
# Usage: python <args>. A real python earlier on PATH still wins.
# Outputs: eligible bare python takes precedence; selected runtime owns argv, stdin, stdout, stderr and exit status.
# Failure: one actionable diagnostic and status 127 when no Python 3.10+ exists.
# Used by: independent Claude and Codex plugins; canonical copy propagated by foundry.
# Probe before execution: versioned names are not evidence of runtime eligibility.
if [ "${AI_RIG_PYTHON_PROBE:-}" = 1 ]; then exit 127; fi
PROBE='import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 127)'
for runtime in python python3 python3.20 python3.19 python3.18 python3.17 python3.16 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$runtime" >/dev/null 2>&1 && AI_RIG_PYTHON_PROBE=1 "$runtime" -c "$PROBE" </dev/null >/dev/null 2>&1; then
        exec "$runtime" "$@"
    fi
done
printf '%s\n' 'python: no Python 3.10+ found on PATH (python3, python3.10-python3.20); install one' >&2
exit 127
