#!/usr/bin/env python3
"""check-index-currency — verify codemap index matches current source tree.

Two-tier check (prefer false-stale over missed-stale):
  Tier 1 (git repo): compare stored git_sha vs HEAD; flag dirty .py files.
  Tier 2 (no git / git_sha absent): compare stored file_shas vs current
      content using mtime pre-filter then git blob SHA-1 or MD5 verify.

The index itself is read under a shared read lease
(:func:`codemap_py.rwgate.read_lease`), never with a bare ``json.load``: the gate's
contract is that "no launcher, adapter, or consumer is permitted a token-free
filesystem read of the index", and this launcher is a consumer like any other. Only
the index read is leased — the Tier 2 source-tree walk and hashing touch project
files, not the index, and holding the lease across them would make every currency
check block a concurrent writer for the length of a full tree walk.

Usage:
    check-index-currency --index-path <path> [--root <path>] [--field <name>]

Options:
    --index-path <path>  Path to codemap index JSON file.
    --root <path>        Project root (default: git toplevel or cwd).
    --field <name>       Print only the named field from result JSON and exit.
                         Useful in bash: STATUS=$(check-index-currency ... --field status)

Output (stdout):
    JSON object:
        {"status": "current"|"stale"|"no_index", "reason": "<text>", "changed_count": N}

Exit codes:
    0 — current
    1 — stale
    2 — no_index (index file not found, unreadable, or its read gate unavailable)
    3 — argument error
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from codemap_py import rwgate  # noqa: E402  (needs the sys.path insert above)

_GIT_TIMEOUT = 5
# DoS guard, held at the query engine's own ceiling (``query._MAX_INDEX_SIZE_BYTES``).
# It must never be TIGHTER than what the engine will serve: this probe refusing a file
# the engine reads happily answers ``no_index`` — indistinguishable from "no index
# exists" — so the staleness gate silently stops firing on exactly the large
# repositories that need it most. Measured on this repository at 131 MB, well past the
# former 50 MB cap. Raising the value in one place and not the other re-opens that;
# ``TestIndexSizeCapAgreement`` fails if they drift apart.
MAX_INDEX_SIZE = 512 * 1024 * 1024

# Deliberately far below the gate's 30 s default and every consumer's own subprocess
# budget (15 s in cc_oss/bin/detect_codemap.py, the tightest one measured). A live
# writer holds its intent for the whole index build — minutes on a real tree — so a
# longer wait never turns into a successful read; it only risks the consumer's
# timeout firing first, and every consumer treats its own timeout as "assume
# current", which is the missed-stale this checker exists to prevent. Failing fast to
# "stale" under a live writer keeps the module's stated bias intact.
_LEASE_TIMEOUT = 2.0

SKIP_DIRS = frozenset(
    {
        ".git",
        ".venv",
        "venv",
        "__pycache__",
        ".tox",
        "dist",
        "build",
        ".eggs",
        "node_modules",
        ".mypy_cache",
        ".pytest_cache",
        ".ruff_cache",
        "htmlcov",
    }
)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _sha256_file(path: Path) -> str:
    """Return hex SHA-256 of file content.

    Args:
        path: File to hash.

    Returns:
        Lowercase hex digest string.
    """
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def _md5_file(path: Path) -> str:
    """Return hex MD5 of file content.

    Args:
        path: File to hash.

    Returns:
        Lowercase hex digest string.
    """
    h = hashlib.md5(usedforsecurity=False)
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def _git_blob_shas(root: Path) -> dict[str, str] | None:
    """Return git blob SHAs for all tracked .py files, or None if git unavailable.

    Args:
        root: Project root used as cwd for git.

    Returns:
        Mapping from POSIX relpath to 40-char blob SHA, or None on git failure.
    """
    try:
        out = subprocess.check_output(
            ["git", "ls-files", "-s", "-z", "--", "*.py"],  # noqa: S607 - git resolved via PATH on purpose
            cwd=str(root),
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=_GIT_TIMEOUT,
        )
        result: dict[str, str] = {}
        for entry in out.split("\0"):
            entry = entry.strip()
            if not entry:
                continue
            try:
                meta, rel_path = entry.split("\t", 1)
                sha = meta.split()[1]
                result[rel_path] = sha
            except (ValueError, IndexError):
                continue
        return result
    except Exception:
        return None


def _detect_hash_algo(stored_shas: dict[str, str]) -> str:
    """Detect hash algorithm from stored SHA length.

    Args:
        stored_shas: Mapping of relpath to stored hash string from file_shas.

    Returns:
        ``"git"`` for 40-char (git blob SHA-1), ``"md5"`` for 32-char (MD5),
        ``"sha256"`` for 64-char (SHA-256 legacy), ``"md5"`` as default.
    """
    for sha in stored_shas.values():
        if sha:
            n = len(sha)
            if n == 40:
                return "git"
            if n == 32:
                return "md5"
            if n == 64:
                return "sha256"
    return "md5"


def _iter_py_files(root: Path) -> dict[str, Path]:
    """Walk root with SKIP_DIRS pruning, returning POSIX relpath to Path for .py non-symlinks.

    Args:
        root: Project root to walk.

    Returns:
        Mapping from POSIX-relative path string to absolute Path for each .py file found.
    """
    result: dict[str, Path] = {}
    for dirpath_str, dirnames, filenames in os.walk(root, topdown=True):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        dp = Path(dirpath_str)
        for fn in filenames:
            if fn.endswith(".py"):
                fp = dp / fn
                if not fp.is_symlink():
                    try:
                        result[fp.relative_to(root).as_posix()] = fp
                    except ValueError:
                        pass
    return result


def _git_toplevel() -> Path | None:
    """Return resolved path of git repository root, or None when unavailable.

    Returns:
        Resolved Path or None.
    """
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],  # noqa: S607 - git resolved via PATH on purpose
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=_GIT_TIMEOUT,
        ).strip()
        return Path(out).resolve() if out else None
    except Exception:
        return None


def _git_head(root: Path) -> str | None:
    """Return current HEAD SHA, or None when git unavailable or not a repo.

    Args:
        root: Project root used as cwd.

    Returns:
        40-char hex SHA or None.
    """
    try:
        return (
            subprocess.check_output(
                ["git", "rev-parse", "HEAD"],  # noqa: S607 - git resolved via PATH on purpose
                cwd=str(root),
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=_GIT_TIMEOUT,
            ).strip()
            or None
        )
    except Exception:
        return None


def _git_dirty_py_count(root: Path) -> int:
    """Return count of uncommitted .py file changes (staged + unstaged).

    Args:
        root: Project root used as cwd.

    Returns:
        Number of dirty .py entries, or 0 on any git failure.
    """
    try:
        out = subprocess.check_output(
            ["git", "status", "--porcelain", "--", "*.py"],  # noqa: S607 - git resolved via PATH on purpose
            cwd=str(root),
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=_GIT_TIMEOUT,
        )
        return sum(1 for line in out.splitlines() if line.strip())
    except Exception:
        return 0


def _parse_scanned_at(value: object) -> float:
    """Parse scanned_at ISO-8601 string to POSIX timestamp; return 0.0 on failure.

    Args:
        value: scanned_at field from index JSON.

    Returns:
        POSIX float timestamp, or 0.0 when unparsable.
    """
    if not isinstance(value, str):
        return 0.0
    text = value.strip()
    if not text or "T" not in text:
        return 0.0
    try:
        parsed = datetime.fromisoformat(text.removesuffix("Z") + "+00:00" if text.endswith("Z") else text)
    except ValueError:
        return 0.0
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc).timestamp()


def _read_index(index_path: Path) -> dict | None:
    """Read and parse index JSON under a shared read lease, enforcing the size limit.

    Uses the gate's :func:`codemap_py.rwgate.read_lease` primitive rather than its
    ``read_index`` convenience wrapper, because this function keeps policy the wrapper
    does not have: a 50 MB size guard, and "unparsable is not fatal, it is just
    ``None``". Entering through ``read_index`` would parse the file a second time and
    surface its ``IndexUnreadable`` instead of that policy.

    The lease covers the parse only. An absent or oversized file is rejected before any
    lease is taken, so a currency check against a project that has no index never
    creates a coordination directory beside it.

    Args:
        index_path: Path to index file.

    Returns:
        Parsed dict, or None when the file is absent, oversized, unreadable, or is
        valid JSON that is not an object.

    Raises:
        rwgate.IndexBusy: a live writer still held the index at ``_LEASE_TIMEOUT``.
        rwgate.CoordinationUnavailable: the ``.index-rw`` root beside the index could
            not be created or locked, so no leased read is possible.
    """
    try:
        if index_path.stat().st_size > MAX_INDEX_SIZE:
            return None
    except OSError:
        return None
    with rwgate.read_lease(index_path, timeout=_LEASE_TIMEOUT):
        try:
            with index_path.open(encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError, RecursionError):
            return None
    return data if isinstance(data, dict) else None


def _read_index_or_failure(index_path: Path) -> tuple[dict | None, tuple[dict, int] | None]:
    """Load the index for a currency check, or produce the result that ends the check.

    Exactly one element of the returned pair is ever non-``None``. Keeping the mapping
    here rather than inline gives each gate failure the status it actually means: a
    live writer holds its intent for the whole rebuild, so the index on disk is about
    to be replaced and ``stale`` is the honest answer under this module's
    prefer-false-stale bias; an unusable coordination root means the index cannot be
    consulted at all, which is operationally the same as an unreadable one.

    Args:
        index_path: Path to the index JSON file.

    Returns:
        ``(index, None)`` once the index has parsed, else ``(None, result)`` where
        *result* is the ``(result_dict, exit_code)`` pair the caller must return.
    """
    if not index_path.exists():
        return None, _result("no_index", f"index not found: {index_path}")
    try:
        index = _read_index(index_path)
    except rwgate.IndexBusy as exc:
        return None, _result("stale", f"index busy under a live writer: {exc}")
    except rwgate.CoordinationUnavailable as exc:
        return None, _result("no_index", f"index read gate unavailable: {exc}")
    if index is None:
        return None, _result("no_index", f"index unreadable or oversized: {index_path}")
    return index, None


def _result(status: str, reason: str, changed_count: int = 0) -> tuple[dict, int]:
    """Build result dict and exit code.

    Args:
        status: "current", "stale", or "no_index".
        reason: Human-readable explanation.
        changed_count: Number of changed/new/deleted files (0 for non-stale).

    Returns:
        Tuple of (result_dict, exit_code).
    """
    code = {"current": 0, "stale": 1, "no_index": 2}.get(status, 1)
    return {"status": status, "reason": reason, "changed_count": changed_count}, code


# ---------------------------------------------------------------------------
# Core check
# ---------------------------------------------------------------------------


def _git_blob_changed(relpath: str, stored_sha: str, git_blobs: dict[str, str] | None) -> bool:
    """Report whether a stored git blob SHA disagrees with the working tree.

    A file git no longer reports a blob for counts as changed, and so does every file
    when ``git ls-files`` itself failed: an index whose SHAs cannot be corroborated is
    not evidence of currency, and this module prefers a false stale over a missed one.

    Args:
        relpath: POSIX-relative path of the file being checked.
        stored_sha: Blob SHA recorded in the index for *relpath*.
        git_blobs: Current blob SHAs by relpath, or None when git was unavailable.

    Returns:
        True when the file must be treated as changed.
    """
    current_sha = git_blobs.get(relpath) if git_blobs is not None else None
    return current_sha is None or current_sha != stored_sha


def _hashed_file_changed(
    relpath: str,
    stored_sha: str,
    current_py: dict[str, Path],
    algo: str,
    scanned_ts: float,
) -> bool:
    """Report whether a stored content hash disagrees with the file on disk.

    Deletions are not reported here — the caller has already compared the two path
    sets, so a path absent from *current_py* at this point cannot be a deletion and is
    left alone. An unreadable file counts as changed; a file whose mtime predates the
    scan is trusted without hashing.

    Args:
        relpath: POSIX-relative path of the file being checked.
        stored_sha: Content hash recorded in the index for *relpath*.
        current_py: Mapping of relpath to absolute Path for .py files found on disk.
        algo: Hash algorithm detected from the stored digests ("md5" or "sha256").
        scanned_ts: POSIX timestamp of the index scan, or 0.0 when unknown.

    Returns:
        True when the file must be treated as changed.
    """
    path = current_py.get(relpath)
    if path is None:
        return False
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return True
    if scanned_ts and mtime <= scanned_ts:
        return False  # mtime pre-filter: not modified since scan
    try:
        current_sha = _md5_file(path) if algo == "md5" else _sha256_file(path)
    except OSError:
        return True
    return current_sha != stored_sha


def _changed_paths(
    stored_py: dict[str, str],
    current_py: dict[str, Path],
    algo: str,
    git_blobs: dict[str, str] | None,
    scanned_ts: float,
) -> list[str]:
    """Return the stored paths whose current content disagrees with the index.

    Args:
        stored_py: Mapping of relpath to stored hash, .py entries only.
        current_py: Mapping of relpath to absolute Path for .py files found on disk.
        algo: Hash algorithm detected from the stored digests.
        git_blobs: Current git blob SHAs, or None when *algo* is not ``"git"``.
        scanned_ts: POSIX timestamp of the index scan, or 0.0 when unknown.

    Returns:
        Changed relpaths, in the order they appear in *stored_py*.
    """
    if algo == "git":
        return [rel for rel, sha in stored_py.items() if _git_blob_changed(rel, sha, git_blobs)]
    return [rel for rel, sha in stored_py.items() if _hashed_file_changed(rel, sha, current_py, algo, scanned_ts)]


def _tier1_result(root: Path, stored_git_sha: str, current_git_sha: str) -> tuple[dict, int]:
    """Decide currency from git alone — fast, no file reads.

    Args:
        root: Project root directory.
        stored_git_sha: HEAD SHA recorded in the index.
        current_git_sha: HEAD SHA of the working tree.

    Returns:
        Tuple of (result_dict, exit_code).
    """
    if stored_git_sha != current_git_sha:
        short_old = stored_git_sha[:8]
        short_new = current_git_sha[:8]
        return _result("stale", f"HEAD changed {short_old}→{short_new}")
    dirty = _git_dirty_py_count(root)
    if dirty:
        return _result("stale", f"{dirty} uncommitted .py change(s)", dirty)
    return _result("current", "HEAD matches, no dirty .py files")


def _tier2_result(index: dict, root: Path) -> tuple[dict, int]:
    """Decide currency by comparing stored file_shas against the source tree.

    Used when git cannot answer: either the tree is not a repository or the index
    predates the ``git_sha`` field. Path-set differences (new and deleted files) are
    settled before any hashing, so an obviously stale index costs no file reads.

    Args:
        index: Parsed index mapping.
        root: Project root directory.

    Returns:
        Tuple of (result_dict, exit_code).
    """
    file_shas: dict[str, str] = index.get("file_shas", {})
    # Only .py entries; exclude synthetic (__coverage_mtime__ etc.)
    stored_py = {k: v for k, v in file_shas.items() if k.endswith(".py") and not k.startswith("__")}

    if not stored_py:
        return _result("stale", "no file_shas in index — rebuild required")

    scanned_ts = _parse_scanned_at(index.get("scanned_at", ""))

    try:
        current_py = _iter_py_files(root)
    except Exception as exc:
        return _result("stale", f"filesystem walk failed: {exc}")

    new_files = set(current_py) - set(stored_py)
    if new_files:
        return _result("stale", f"{len(new_files)} new .py file(s)", len(new_files))

    deleted = set(stored_py) - set(current_py)
    if deleted:
        return _result("stale", f"{len(deleted)} .py file(s) deleted", len(deleted))

    # Detect stored algorithm from SHA length, then verify content
    algo = _detect_hash_algo(stored_py)
    git_blobs: dict[str, str] | None = _git_blob_shas(root) if algo == "git" else None

    changed = _changed_paths(stored_py, current_py, algo, git_blobs, scanned_ts)
    if changed:
        return _result("stale", f"{len(changed)} .py file(s) changed", len(changed))

    return _result("current", "all source files match index")


def check_currency(index_path: Path, root: Path) -> tuple[dict, int]:
    """Check whether the codemap index is current with the source tree.

    Tier 1 answers from git when both the index and the working tree carry a HEAD SHA;
    otherwise Tier 2 falls back to comparing stored content hashes.

    Args:
        index_path: Path to the index JSON file.
        root: Project root directory.

    Returns:
        Tuple of (result_dict, exit_code).
    """
    index, failure = _read_index_or_failure(index_path)
    if failure is not None:
        return failure

    stored_git_sha: str | None = index.get("git_sha")
    current_git_sha = _git_head(root)

    if current_git_sha is not None and stored_git_sha is not None:
        return _tier1_result(root, stored_git_sha, current_git_sha)

    return _tier2_result(index, root)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    """CLI entry point.

    Args:
        argv: Argument list override (defaults to sys.argv[1:]).

    Returns:
        Exit code.
    """
    parser = argparse.ArgumentParser(
        description="Verify codemap index currency against current source tree.",
    )
    parser.add_argument("--index-path", required=True, help="Path to codemap index JSON.")
    parser.add_argument("--root", default=None, help="Project root (default: git toplevel or cwd).")
    parser.add_argument(
        "--field",
        default=None,
        help="Print only this field from the result JSON (e.g. --field status).",
    )
    args = parser.parse_args(argv)

    index_path = Path(args.index_path).expanduser()

    if args.root:
        root = Path(args.root).expanduser().resolve()
    else:
        root = _git_toplevel() or Path.cwd().resolve()

    result, exit_code = check_currency(index_path, root)

    if args.field:
        val = result.get(args.field)
        sys.stdout.write(f"{val}\n")
    else:
        sys.stdout.write(json.dumps(result) + "\n")

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
