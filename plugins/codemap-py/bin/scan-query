#!/usr/bin/env python3
"""scan-query — thin launcher for the codemap query engine (plan §12 Phase 3, step 2).

Phase 3 slice 2 moved the query implementation into :mod:`codemap_py.query`.
This launcher only wires ``<plugin-root>/src`` onto the import path and hands
off to :func:`codemap_py.query.main` — same argv contract, same exit codes,
same JSON output as before the move. See ``codemap_py.query`` for the full
command reference (``deps``, ``rdeps``, ``symbol``, ``fn-deps``, ``coverage``,
``diff-impact``, ``batch``, and friends) and their ``--help`` output.

:mod:`codemap_py.cli` (the ``codemap-py query`` dispatcher) does not invoke
this file — it calls :func:`codemap_py.query.main` in-process, in-process
under its own read lease. This launcher exists for direct invocation
(``scan-query <cmd> ...``) and for tests that exercise the standalone script.
"""

from __future__ import annotations

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from codemap_py.query import main

if __name__ == "__main__":
    main()
