#!/usr/bin/env python3
"""scan-index — thin launcher over :mod:`codemap_py.graph` (plan §12 Phase 3 slices 3+4).

Build the codemap structural index for a project: scans all Python files (import
graph, per-symbol call graph, docstrings, mock patches, dynamic/subprocess imports,
Sphinx/MkDocs xrefs, pytest fixture graph, optional coverage annotation) and writes
``.cache/codemap/<project>.json`` (or ``$CODEMAP_INDEX_DIR/<project>.json`` when set).

Phase 3 slices 3+4 (plan §12) moved the scan/parse implementation out of this file
into the importable package — file discovery and single-file AST parsing live in
:mod:`codemap_py.scanner`; cross-module graph construction, coverage, and the
``scan()``/``incremental_scan()`` orchestration live in :mod:`codemap_py.graph`. This
launcher only resolves ``src/`` onto ``sys.path`` and delegates to
:func:`codemap_py.graph.main` — same argv contract and exit codes as before the move.

Usage:
    scan-index
    scan-index --root /path/to/project
    scan-index --incremental          # re-parse only changed files (requires an existing v3 index)
"""

from __future__ import annotations

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from codemap_py.graph import main

if __name__ == "__main__":
    main()
