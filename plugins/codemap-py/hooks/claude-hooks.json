{
  "description": "codemap-py plugin hooks: ambient index status injection + skill telemetry + redundant-scan guard",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook record-exhausted.py",
            "type": "command"
          },
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook log-tool-use.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook log-tool-use.py",
            "type": "command"
          }
        ],
        "matcher": "Grep|Read|Glob"
      },
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook record-exhausted.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook log-skill-start.py",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook guard-redundant-scan.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook seed-session.py",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/codemap-py\" --run-hook inject-preamble.py",
            "type": "command"
          }
        ]
      }
    ]
  }
}
