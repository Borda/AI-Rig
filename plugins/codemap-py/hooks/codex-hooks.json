{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook record-exhausted.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook record-exhausted.py; exit $LASTEXITCODE",
            "type": "command"
          },
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook log-tool-use.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook log-tool-use.py; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook log-tool-use.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook log-tool-use.py; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Grep|Read|Glob"
      },
      {
        "hooks": [
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook record-exhausted.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook record-exhausted.py; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook guard-redundant-scan.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook guard-redundant-scan.py; exit $LASTEXITCODE",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "CODEMAP_RUNTIME=codex \"$PLUGIN_ROOT/bin/codemap-py\" --run-hook inject-preamble.py",
            "commandWindows": "$env:CODEMAP_RUNTIME='codex'; & \"$env:PLUGIN_ROOT\\bin\\codemap-py.cmd\" --run-hook inject-preamble.py; exit $LASTEXITCODE",
            "type": "command"
          }
        ]
      }
    ]
  }
}
