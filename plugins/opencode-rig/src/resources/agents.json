{
  "schema": 1,
  "agents": {
    "rig-investigator": {
      "description": "Read-only failure investigation and root-cause analysis",
      "mode": "subagent",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-builder": {
      "description": "Bounded implementation of an assigned change with focused tests",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-creator": {
      "description": "Outward-facing content creator for articles, user docs, decks, threads, animated SVGs, and short-video source",
      "mode": "subagent",
      "steps": 30,
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-auditor": {
      "description": "Independent read-only auditor returning structured findings",
      "mode": "subagent",
      "steps": 25,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-challenger": {
      "description": "Adversarial read-only challenger that tries to falsify a change",
      "mode": "subagent",
      "steps": 25,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-verifier": {
      "description": "Read-only verifier that checks whether a fix closes its finding",
      "mode": "subagent",
      "steps": 25,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-researcher": {
      "description": "Read-only evidence researcher that grades claims against its sources",
      "mode": "subagent",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": ".env*", "effect": "deny" },
        { "action": "read", "resource": "**/.env*", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
        { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
        { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
        { "action": "read", "resource": "~/.config/**", "effect": "deny" },
        { "action": "read", "resource": "**/.config/**", "effect": "deny" },
        { "action": "read", "resource": "*credentials*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },
    "rig-optimizer": {
      "description": "Read-only performance analyst that recomputes benchmark deltas and judges methodology",
      "mode": "subagent",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    }
  }
}
