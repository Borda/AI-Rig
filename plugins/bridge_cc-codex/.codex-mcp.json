{
  "mcpServers": {
    "bridge": {
      "args": [
        "bin/bridge_mcp.py",
        "--stdio"
      ],
      "command": "python",
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "CODEX_HOME",
        "CC_CODEX_BRIDGE_DEPTH"
      ],
      "tool_timeout_sec": 900
    },
    "bridge-input": {
      "args": [
        "bin/user_questions_mcp.py",
        "--stdio"
      ],
      "command": "python",
      "cwd": ".",
      "tool_timeout_sec": 3600
    }
  }
}
