# Enforce LF line endings for all text source files.
# Prevents CRLF contamination on Windows checkouts — critical for bash shebangs
# and Python/JS scripts that are also invoked on POSIX systems.
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf

# Codemap launchers include extensionless Python, POSIX-shell, and Windows-batch
# files whose exact bytes are part of generated benchmark manifest identities.
plugins/codemap-py/bin/* text eol=lf
plugins/codemap-py/LICENSE text eol=lf
plugins/codemap-py/NOTICE  text eol=lf

# Every plugin's extensionless `bin/python` fallback is a shebang script propagated byte-identically
# from foundry; CRLF would break both the shebang and the propagation check.
plugins/*/bin/python text eol=lf

# Extensionless Codex Rig package text participates in exact hash identity.
plugins/codex-rig/LICENSE text eol=lf
plugins/codex-rig/NOTICE  text eol=lf

# Binary assets — never diff or convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.whl  binary
*.tar.gz binary
